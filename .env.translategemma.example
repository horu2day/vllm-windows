# Copy to .env.translategemma and adjust.
# Defaults below are tuned for a single RTX 3060 12GB.

# Host port for Web UI / REST API / MCP
PORT=8022

# GPU index (nvidia-smi -L)
NVIDIA_VISIBLE_DEVICES=0

# Model size: 4b | 12b | 27b
#   4b  Q4 ~3.0 GB   fast, lower quality
#   12b Q4 ~7.3 GB   <- fits 12 GB, best quality/VRAM tradeoff
#   12b Q8 ~12.5 GB  does NOT fit 12 GB
#   27b        15 GB+ does NOT fit 12 GB
MODEL_NAME=12b

# Quantization bits: 4 | 8
QUANTIZATION=4

# Inference backend: gguf | pytorch
BACKEND=gguf

# Seconds idle before the model is evicted from VRAM (0 = evict immediately).
# Raise it if you translate often; lower it if you also need VRAM for vLLM.
GPU_IDLE_TIMEOUT=600

# Chunking. Values above 100 truncate translations upstream - leave at 100.
MAX_CHUNK_LENGTH=100
DEFAULT_OVERLAP=0
REPETITION_PENALTY=1.0

# Mirror, e.g. https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co
